APP_NAME="Pulse"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# Collector schedule (Laravel scheduler — run `php artisan schedule:work` or NativePHP desktop)
BIOMETRIC_COLLECT_INTERVAL_MINUTES=5
# Optional fallback when no collector name is set on the dashboard
# BIOMETRIC_COLLECTOR_NAME=
BIOMETRIC_DEVICE_PORT=4370
BIOMETRIC_DEVICE_TIMEOUT=10
BIOMETRIC_DEVICE_REACHABILITY_TIMEOUT=5
BIOMETRIC_STATUS_POLL_SECONDS=10
BIOMETRIC_DEVICE_MODEL=K30
BIOMETRIC_EXPORT_TABLE=biometric_attendance_logs
BIOMETRIC_KEEP_LOCAL_SQL=false
BIOMETRIC_LOGS_PER_PAGE=25

# Deleted logs older than the dashboard "Months to keep" setting are archived here
# BIOMETRIC_DELETED_LOGS_DIR=biometric-deleted-logs

# S3 log upload — gzipped JSON under biometric_logs/{YYYY}/{MM}/{biometric_name}/
# Uses DB_BACKUP_S3_* by default (same credentials / bucket as People360).
# Encrypt secrets at rest: php artisan secrets:encrypt-env  (values become enc:…; decrypted only when used)
BIOMETRIC_S3_ENABLED=true
BIOMETRIC_S3_DISK=backup-s3
BIOMETRIC_S3_PREFIX=biometric_logs
# Optional overrides (leave empty to use DB_BACKUP_S3_*):
# BIOMETRIC_S3_KEY=
# BIOMETRIC_S3_SECRET=
# BIOMETRIC_S3_REGION=
# BIOMETRIC_S3_BUCKET=

# Desktop installer updates + biometric log uploads (same S3 credentials as People360)
# Bucket: skolaris-payroll-backups-prod
#   - biometric_installer/  (desktop installers)
#   - biometric_logs/       (gzipped JSON attendance exports)
# Use DB_BACKUP_S3_* so keys survive NativePHP packaging (do not add *_SECRET to nativephp cleanup_env_keys)
DB_BACKUP_S3_KEY=
DB_BACKUP_S3_SECRET=
DB_BACKUP_S3_REGION=ap-southeast-2
DB_BACKUP_S3_BUCKET=skolaris-payroll-backups-prod

DESKTOP_INSTALLER_UPDATE_ENABLED=true
DESKTOP_INSTALLER_S3_PREFIX=biometric_installer
DESKTOP_INSTALLER_CHECK_INTERVAL_MINUTES=0

# NativePHP desktop packaging
NATIVEPHP_APP_VERSION=1.0.0
NATIVEPHP_APP_ID=ph.edu.icct.biometric-collector
NATIVEPHP_APP_AUTHOR="ICCT Colleges"
NATIVEPHP_APP_COPYRIGHT="Copyright © ICCT Colleges"
NATIVEPHP_APP_DESCRIPTION="Pulse — ZkTeco biometric log collector for multiple campuses"
NATIVEPHP_APP_WEBSITE=https://icct.edu.ph
NATIVEPHP_UPDATER_ENABLED=true
NATIVEPHP_UPDATER_PROVIDER=github
NATIVEPHP_FORCE_UPDATE=true
GITHUB_OWNER=kenjiex01
GITHUB_REPO=pulse-collector
GITHUB_PRIVATE=true
GITHUB_V_PREFIXED_TAG_NAME=true
GITHUB_CHANNEL=latest
GITHUB_RELEASE_TYPE=release
# Build-time only (never commit). `scripts/build-desktop.sh` uses `gh auth token` if empty.
GITHUB_TOKEN=
