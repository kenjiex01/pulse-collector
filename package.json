{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "desktop:mac": "php artisan native:build mac arm64 --no-interaction",
        "desktop:mac-intel": "php artisan native:build mac x64 --no-interaction",
        "desktop:win": "php artisan native:build win x64 --no-interaction",
        "desktop:all": "bash scripts/build-desktop.sh all"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    }
}
